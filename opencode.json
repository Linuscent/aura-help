{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "astro-docs": {
        "type": "remote",
        "url": "https://mcp.docs.astro.build/mcp"
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--headless",
          "--isolated",
          "--output-dir",
          ".playwright-mcp"
        ]
      }
    }
  }
}
